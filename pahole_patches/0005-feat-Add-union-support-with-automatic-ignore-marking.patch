From 3d2c7bc9b242df443d1bb7a92c2f8bdf8b58a967 Mon Sep 17 00:00:00 2001
From: Or Magen <ormagen@amazon.com>
Date: Mon, 19 Jan 2026 17:12:59 +0200
Subject: [PATCH 5/5] feat: Add union support with automatic ignore marking

Unions are now parsed and marked with ignore=True, ignore_reason='union'
since they have different padding rules (members overlap).

Handles unions without explicit size line by calculating max member size.

Test added: test_union_marked_as_ignored
Validation: pthread_attr_t union correctly extracted and marked

All 16 edge case tests pass
---
 implementation/pipeline/extraction/pahole.py  | 19 +++++++++++++-----
 .../extraction/test_pahole_edge_cases.py      | 20 +++++++++++++++++++
 2 files changed, 34 insertions(+), 5 deletions(-)

diff --git a/implementation/pipeline/extraction/pahole.py b/implementation/pipeline/extraction/pahole.py
index 1869838..ab0fc0a 100644
--- a/implementation/pipeline/extraction/pahole.py
+++ b/implementation/pipeline/extraction/pahole.py
@@ -85,11 +85,12 @@ class PaholeExtractor(IStructExtractor):
                 
                 i += 1
                 
-                # Next line should be struct/class
+                # Next line should be struct/class/union
                 if i < len(lines):
-                    # Match struct/class with name, handle inheritance, typedef, templates
-                    struct_match = re.match(r'^(struct|class)\s+(.+?)\s*\{', lines[i])
+                    # Match struct/class/union with name, handle inheritance, typedef, templates
+                    struct_match = re.match(r'^(struct|class|union)\s+(.+?)\s*\{', lines[i])
                     if struct_match:
+                        struct_type = struct_match.group(1)
                         # Extract struct name from complex declarations
                         full_decl = struct_match.group(2)
                         if ' : ' in full_decl:
@@ -150,13 +151,21 @@ class PaholeExtractor(IStructExtractor):
                             
                             i += 1
                         
-                        if struct_name and struct_size > 0:
+                        if struct_name and (struct_size > 0 or struct_type == 'union'):
+                            # For unions without explicit size, calculate from members
+                            if struct_type == 'union' and struct_size == 0 and members:
+                                struct_size = max(m.size for m in members)
+                            
+                            # Mark unions as ignored (different padding rules)
+                            is_union = struct_type == 'union'
                             structs.append(StructInfo(
                                 name=struct_name,
                                 size=struct_size,
                                 members=tuple(members),
                                 file_path=file_path,
-                                line=line_num
+                                line=line_num,
+                                ignore=is_union,
+                                ignore_reason="union" if is_union else None
                             ))
                         # Continue from current position (i already advanced past };)
                         continue
diff --git a/tests/pipeline/extraction/test_pahole_edge_cases.py b/tests/pipeline/extraction/test_pahole_edge_cases.py
index dad7251..5e0fbf6 100644
--- a/tests/pipeline/extraction/test_pahole_edge_cases.py
+++ b/tests/pipeline/extraction/test_pahole_edge_cases.py
@@ -280,6 +280,26 @@ class scv_bag<int> : public _scv_data_structure {
         assert structs[0].name == "scv_bag<int>"
         assert len(structs[0].members) == 1
     
+    def test_union_marked_as_ignored(self):
+        """Test that unions are parsed but marked as ignored."""
+        output = """/* <29> /tmp/test.cpp:1 */
+union pthread_attr_t {
+	char                       __size[56];           /*     0    56 */
+	long int                   __align;              /*     0     8 */
+
+	/* size: 56, cachelines: 1, members: 2 */
+};"""
+        
+        extractor = PaholeExtractor()
+        structs = extractor._parse_pahole_output(output)
+        
+        assert len(structs) == 1
+        assert structs[0].name == "pthread_attr_t"
+        assert structs[0].size == 56
+        assert structs[0].ignore == True
+        assert structs[0].ignore_reason == "union"
+        assert len(structs[0].members) == 2  # Members still extracted
+    
     def test_empty_lines_and_whitespace(self):
         """Test that empty lines and extra whitespace don't break parsing."""
         output = """/* <29> /tmp/test.cpp:1 */
-- 
