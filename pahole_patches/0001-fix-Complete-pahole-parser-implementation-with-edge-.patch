+"""Test cases for pahole output parsing edge cases."""
+
+import pytest
+from implementation.pipeline.extraction.pahole import PaholeExtractor
+
+
+@pytest.mark.unit
+class TestPaholeParsingEdgeCases:
+    """Test pahole parser handles various edge cases."""
+    
+    def test_simple_types(self):
+        """Test parsing simple types (char, int, double)."""
+        output = """/* <29> /tmp/test.cpp:1 */
+struct Simple {
+	char                       a;                    /*     0     1 */
+	int                        b;                    /*     4     4 */
+	double                     c;                    /*     8     8 */
+
+	/* size: 16, cachelines: 1, members: 3 */
+};"""
+        
+        extractor = PaholeExtractor()
+        structs = extractor._parse_pahole_output(output)
+        
+        assert len(structs) == 1
+        assert structs[0].name == "Simple"
+        assert structs[0].size == 16
+        assert len(structs[0].members) == 3
+        assert structs[0].members[0].name == "a"
+        assert structs[0].members[0].type == "char"
+        assert structs[0].members[0].size == 1
+        assert structs[0].members[0].offset == 0
+    
+    def test_complex_type_with_spaces(self):
+        """Test parsing complex types with spaces (class vector<...>)."""
+        output = """/* <29> /tmp/test.cpp:1 */
+class WithVector {
+	class vector<std::__cxx11::basic_ostringstream<char, std::char_traits<char>, std::allocator<char> >*, std::allocator<std::__cxx11::basic_ostringstream<char, std::char_traits<char>, std::allocator<char> >*> > m_msg; /*    48    24 */
+
+	/* size: 72, cachelines: 2, members: 1 */
+};"""
+        
+        extractor = PaholeExtractor()
+        structs = extractor._parse_pahole_output(output)
+        
+        assert len(structs) == 1
+        assert len(structs[0].members) == 1
+        assert structs[0].members[0].name == "m_msg"
+        assert "vector" in structs[0].members[0].type
+        assert structs[0].members[0].size == 24
+        assert structs[0].members[0].offset == 48
+    
+    def test_multiword_type(self):
+        """Test parsing multi-word types (class line_reference)."""
+        output = """/* <29> /tmp/test.cpp:1 */
+struct WithClass {
+	class line_reference      m_line_ref;            /*   112     8 */
+	unsigned int              m_counter;             /*   120     4 */
+
+	/* size: 128, cachelines: 2, members: 2 */
+};"""
+        
+        extractor = PaholeExtractor()
+        structs = extractor._parse_pahole_output(output)
+        
+        assert len(structs) == 1
+        assert len(structs[0].members) == 2
+        assert structs[0].members[0].name == "m_line_ref"
+        assert structs[0].members[0].type == "class line_reference"
+        assert structs[0].members[1].name == "m_counter"
+        assert structs[0].members[1].type == "unsigned int"
+    
+    def test_array_member(self):
+        """Test parsing array members (unsigned int m_counter[4])."""
+        output = """/* <29> /tmp/test.cpp:1 */
+struct WithArray {
+	unsigned int               m_global_counter[4];  /*   528    16 */
+	char                       flags[8];             /*   544     8 */
+
+	/* size: 552, cachelines: 9, members: 2 */
+};"""
+        
+        extractor = PaholeExtractor()
+        structs = extractor._parse_pahole_output(output)
+        
+        assert len(structs) == 1
+        assert len(structs[0].members) == 2
+        assert structs[0].members[0].name == "m_global_counter"
+        assert structs[0].members[0].type == "unsigned int"
+        assert structs[0].members[0].size == 16
+        assert structs[0].members[1].name == "flags"
+        assert structs[0].members[1].type == "char"
+    
+    def test_skip_holes(self):
+        """Test that holes are skipped."""
+        output = """/* <29> /tmp/test.cpp:1 */
+struct WithHoles {
+	char                       a;                    /*     0     1 */
+
+	/* XXX 3 bytes hole, try to pack */
+
+	int                        b;                    /*     4     4 */
+
+	/* size: 8, cachelines: 1, members: 2 */
+	/* sum members: 5, holes: 1, sum holes: 3 */
+};"""
+        
+        extractor = PaholeExtractor()
+        structs = extractor._parse_pahole_output(output)
+        
+        assert len(structs) == 1
+        assert len(structs[0].members) == 2  # Holes not counted as members
+    
+    def test_skip_vtable_pointer(self):
+        """Test that vtable pointers are skipped."""
+        output = """/* <29> /tmp/test.cpp:1 */
+class WithVtable {
+public:
+
+	int ()(void) * *           _vptr.WithVtable;     /*     0     8 */
+protected:
+
+	char                       a;                    /*     8     1 */
+
+	/* size: 16, cachelines: 1, members: 2 */
+};"""
+        
+        extractor = PaholeExtractor()
+        structs = extractor._parse_pahole_output(output)
+        
+        assert len(structs) == 1
+        assert len(structs[0].members) == 1  # Only 'a', vtable pointer skipped
+        assert structs[0].members[0].name == "a"
+    
+    def test_access_modifiers_preserved(self):
+        """Test that access modifiers don't break parsing."""
+        output = """/* <29> /tmp/test.cpp:1 */
+class WithAccess {
+private:
+
+	char                       a;                    /*     0     1 */
+protected:
+
+	int                        b;                    /*     4     4 */
+public:
+
+	double                     c;                    /*     8     8 */
+
+	/* size: 16, cachelines: 1, members: 3 */
+};"""
+        
+        extractor = PaholeExtractor()
+        structs = extractor._parse_pahole_output(output)
+        
+        assert len(structs) == 1
+        assert len(structs[0].members) == 3
+    
+    def test_enum_type(self):
+        """Test parsing enum types."""
+        output = """/* <29> /tmp/test.cpp:1 */
+struct WithEnum {
+	enum al_report_log_mode_t  m_log_mode;           /*    72     1 */
+	enum pcapPlatformName      m_pcap_platform;      /*   520     1 */
+
+	/* size: 521, cachelines: 9, members: 2 */
+};"""
+        
+        extractor = PaholeExtractor()
+        structs = extractor._parse_pahole_output(output)
+        
+        assert len(structs) == 1
+        assert len(structs[0].members) == 2
+        assert structs[0].members[0].type == "enum al_report_log_mode_t"
+        assert structs[0].members[1].type == "enum pcapPlatformName"
+    
+    def test_typedef_string(self):
+        """Test parsing typedef types like 'string'."""
+        output = """/* <29> /tmp/test.cpp:1 */
+struct WithString {
+	string                     m_tag;                /*     8    32 */
+	string                     m_line_ref_str;       /*    80    32 */
+
+	/* size: 112, cachelines: 2, members: 2 */
+};"""
+        
+        extractor = PaholeExtractor()
+        structs = extractor._parse_pahole_output(output)
+        
+        assert len(structs) == 1
+        assert len(structs[0].members) == 2
+        assert structs[0].members[0].type == "string"
+        assert structs[0].members[0].size == 32
+    
+    def test_nested_template_types(self):
+        """Test parsing deeply nested template types."""
+        output = """/* <29> /tmp/test.cpp:1 */
+struct WithTemplate {
+	class map<string, vector<shared_ptr<MyClass> > > m_data; /*     0    48 */
+
+	/* size: 48, cachelines: 1, members: 1 */
+};"""
+        
+        extractor = PaholeExtractor()
+        structs = extractor._parse_pahole_output(output)
+        
+        assert len(structs) == 1
+        assert len(structs[0].members) == 1
+        assert structs[0].members[0].name == "m_data"
+        assert "map" in structs[0].members[0].type
+        assert "vector" in structs[0].members[0].type
+    
+    def test_multiple_structs(self):
+        """Test parsing multiple structs in one output."""
+        output = """/* <29> /tmp/test.cpp:1 */
+struct First {
+	char                       a;                    /*     0     1 */
+
+	/* size: 1, cachelines: 1, members: 1 */
+};
+/* <45> /tmp/test.cpp:5 */
+struct Second {
+	int                        b;                    /*     0     4 */
+
+	/* size: 4, cachelines: 1, members: 1 */
+};"""
+        
+        extractor = PaholeExtractor()
+        structs = extractor._parse_pahole_output(output)
+        
+        assert len(structs) == 2
+        assert structs[0].name == "First"
+        assert structs[1].name == "Second"
+    
+    def test_inheritance_single(self):
+        """Test parsing class with single inheritance."""
+        output = """/* <29> /tmp/test.cpp:1 */
+class Derived : public Base {
+	char                       a;                    /*     8     1 */
+
+	/* size: 16, cachelines: 1, members: 1 */
+};"""
+        
+        extractor = PaholeExtractor()
+        structs = extractor._parse_pahole_output(output)
+        
+        assert len(structs) == 1
+        assert structs[0].name == "Derived"
+        assert len(structs[0].members) == 1
+    
+    def test_typedef_struct(self):
+        """Test parsing typedef struct."""
+        output = """/* <79> /tmp/test.cpp:1 */
+struct typedef __va_list_tag __va_list_tag {
+	unsigned int               gp_offset;            /*     0     4 */
+	unsigned int               fp_offset;            /*     4     4 */
+
+	/* size: 8, cachelines: 1, members: 2 */
+};"""
+        
+        extractor = PaholeExtractor()
+        structs = extractor._parse_pahole_output(output)
+        
+        assert len(structs) == 1
+        assert structs[0].name == "__va_list_tag"
+        assert len(structs[0].members) == 2
+    
+    def test_template_with_inheritance(self):
+        """Test parsing template class with inheritance."""
+        output = """/* <29> /tmp/test.cpp:1 */
+class scv_bag<int> : public _scv_data_structure {
+	int                        value;                /*     0     4 */
+
+	/* size: 8, cachelines: 1, members: 1 */
+};"""
+        
+        extractor = PaholeExtractor()
+        structs = extractor._parse_pahole_output(output)
+        
+        assert len(structs) == 1
+        assert structs[0].name == "scv_bag<int>"
+        assert len(structs[0].members) == 1
+    
+    def test_empty_lines_and_whitespace(self):
+        """Test that empty lines and extra whitespace don't break parsing."""
+        output = """/* <29> /tmp/test.cpp:1 */
+struct WithSpaces {
+
+	char                       a;                    /*     0     1 */
+
+
+	int                        b;                    /*     4     4 */
+
+	/* size: 8, cachelines: 1, members: 2 */
+};"""
+        
+        extractor = PaholeExtractor()
+        structs = extractor._parse_pahole_output(output)
+        
+        assert len(structs) == 1
+        assert len(structs[0].members) == 2
+
+
+if __name__ == "__main__":
+    pytest.main([__file__, "-v"])
